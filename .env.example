# Copy to .env.local and fill in. Never commit .env.local.

# --- Firebase web config (public; Firebase console > Project settings > Your apps) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Set to "true" to point the app at the local Firebase Emulator Suite.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# Local emulator hosts for the server (set only for local development).
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# --- Server-only secrets (Firebase console > Project settings > Service accounts) ---
# Never prefix these with NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the key on one line with \n for line breaks, wrapped in double quotes.
FIREBASE_PRIVATE_KEY=

# Gemini Developer API key from Google AI Studio (needed from Milestone 6).
GEMINI_API_KEY=

# AI limits. Set these from the limits Google AI Studio shows for YOUR project,
# keeping a margin below them. Defaults are shown.
# AI_MODEL_BULK=gemini-3.5-flash-lite
# AI_MODEL_QUALITY=gemini-3.8-flash
# AI_DAILY_REQUEST_CAP=450
# AI_REQUESTS_PER_MINUTE=10
# AI_REQUESTS_PER_ADVANCE=4

# "fake" runs analysis with a built-in stand-in instead of Gemini. For local
# development and tests only; it is refused on a deployed site.
# AI_PROVIDER=gemini

# Comma-separated emails allowed to run AI analysis. Protects the shared free quota.
ALLOWED_EMAILS=
