# Copy to .env.local and fill in. Never commit .env.local.

# --- Firebase web config (public; Firebase console > Project settings > Your apps) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Set to "true" to point the app at the local Firebase Emulator Suite.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# --- Server-only secrets (Firebase console > Project settings > Service accounts) ---
# Never prefix these with NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the key on one line with \n for line breaks, wrapped in double quotes.
FIREBASE_PRIVATE_KEY=

# Gemini Developer API key from Google AI Studio (needed from Milestone 6).
GEMINI_API_KEY=

# Comma-separated emails allowed to run AI analysis. Protects the shared free quota.
ALLOWED_EMAILS=
