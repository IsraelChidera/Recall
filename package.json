{
  "name": "recall",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-recall \"vitest run --config vitest.rules.config.mts\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-recall",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-recall \"vitest run --config vitest.e2e.config.mts\""
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^13.3.0",
    "firebase-admin": "^14.5.1",
    "geist": "^1.9.2",
    "jszip": "^3.10.2",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "firebase-tools": "^15.36.0",
    "jsdom": "^31.0.1",
    "puppeteer-core": "^25.17.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
